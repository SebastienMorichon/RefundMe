NODE_ENV=development
LYDOC_DEPLOYMENT_PROFILE=free-beta
DATABASE_URL=postgresql://lydoc:lydoc@localhost:5432/lydoc
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
