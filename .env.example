# Offre d'impression et d'envoi. Les deux valeurs doivent être à true pour l'ouvrir.
MANAGED_POSTAL_ENABLED=false
NEXT_PUBLIC_MANAGED_POSTAL_ENABLED=false

# Envoi postal. Le fournisseur mock ne transmet aucun document hors de Lydoc.
POSTAL_PROVIDER=mock
