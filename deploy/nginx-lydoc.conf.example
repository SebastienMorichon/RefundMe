# Copy into the nginx http{} context and replace every example.com/certificate
# path. Validate with `nginx -t` before reloading. Docker services remain bound
# to loopback; nginx is the only public entry point.

limit_req_zone $binary_remote_addr zone=lydoc_general:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=lydoc_uploads:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=lydoc_connections:10m;

upstream lydoc_web {
  server 127.0.0.1:3000;
  keepalive 16;
}

upstream lydoc_api {
  server 127.0.0.1:3001;
  keepalive 16;
}

server {
  listen 80;
  listen [::]:80;
  server_name app.example.com api.example.com;
  return 308 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name app.example.com;

  ssl_certificate /etc/letsencrypt/live/app.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:LYDOCSSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;
  server_tokens off;

  client_max_body_size 1m;
  client_header_timeout 10s;
  client_body_timeout 10s;
  keepalive_timeout 15s;
  keepalive_requests 100;
  limit_conn lydoc_connections 20;
  limit_req zone=lydoc_general burst=30 nodelay;

  location / {
    proxy_pass http://lydoc_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 3s;
    proxy_send_timeout 15s;
    proxy_read_timeout 65s;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name api.example.com;

  ssl_certificate /etc/letsencrypt/live/api.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:LYDOCSSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;
  server_tokens off;

  client_max_body_size 1m;
  client_header_timeout 10s;
  client_body_timeout 10s;
  keepalive_timeout 15s;
  keepalive_requests 100;
  limit_conn lydoc_connections 20;
  limit_req zone=lydoc_general burst=30 nodelay;

  # nginx buffers the whole multipart body before contacting Node. Slow or
  # incomplete anonymous bodies therefore never occupy an API CDR/OCR slot.
  location = /documents {
    client_max_body_size 21m;
    client_body_timeout 10s;
    proxy_request_buffering on;
    limit_req zone=lydoc_uploads burst=2 nodelay;
    proxy_pass http://lydoc_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 3s;
    proxy_send_timeout 20s;
    proxy_read_timeout 65s;
  }

  location / {
    proxy_request_buffering on;
    proxy_pass http://lydoc_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 3s;
    proxy_send_timeout 15s;
    proxy_read_timeout 65s;
  }
}
