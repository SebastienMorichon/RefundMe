# This file is read by Docker Compose and by the operator backup scripts. The
# web container receives public build arguments only. Backup key material is
# explicitly scrubbed from the API container by docker-compose.production.yml.
# Never add a secret to a NEXT_PUBLIC_* variable.
LYDOC_COMPOSE_PROJECT_NAME=lydoc
LYDOC_API_ENV_FILE=.env.production
LYDOC_DEPLOYMENT_PROFILE=free-beta
LYDOC_BIND_ADDRESS=127.0.0.1
LYDOC_WEB_PORT=3000
LYDOC_API_PORT=3001
LYDOC_POSTGRES_VOLUME=lydoc-production-postgres
LYDOC_DOCUMENT_VOLUME=lydoc-production-documents

POSTGRES_PASSWORD=replace-with-a-strong-database-password
# URL-encode special characters from POSTGRES_PASSWORD in DATABASE_URL.
DATABASE_URL=postgresql://lydoc:replace-with-a-strong-database-password@postgres:5432/lydoc
APP_URL=https://app.example.com
API_URL=https://api.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
SECURITY_CONTACT_EMAIL=security@example.com
PORT=3001
# Replace this placeholder with the exact edge-network gateway used by the
# host TLS proxy (IPv4 /32 or IPv6 /128); never trust an entire private range.
TRUST_PROXY=true
TRUST_PROXY_CIDRS=replace-with-exact-docker-edge-gateway-ip/32
API_GENERAL_RATE_LIMIT_PER_MINUTE=120
SESSION_SECRET=replace-with-at-least-32-random-characters
IDENTITY_OUTBOX_ENCRYPTION_SECRET=replace-with-a-dedicated-identity-outbox-secret-of-at-least-32-characters
MFA_ENCRYPTION_SECRET=replace-with-a-dedicated-secret-of-at-least-32-characters
MFA_ENCRYPTION_KEY_ID=admin-mfa-2026-08
MFA_ENCRYPTION_PREVIOUS_KEYS={}
ADMIN_SESSION_TTL_MINUTES=30
AUTH_SCRYPT_CONCURRENCY=2
AUTH_SCRYPT_QUEUE_LIMIT=8
AUTH_EMAIL_DAILY_GLOBAL_LIMIT=500
AUTH_REGISTER_HOURLY_GLOBAL_LIMIT=100
AUTH_RESEND_HOURLY_GLOBAL_LIMIT=100
AUTH_FORGOT_HOURLY_GLOBAL_LIMIT=100
AUTH_MFA_CHALLENGE_HOURLY_GLOBAL_LIMIT=200
AUTH_REGISTER_HOURLY_IDENTIFIER_LIMIT=10
AUTH_RESEND_HOURLY_IDENTIFIER_LIMIT=5
AUTH_FORGOT_HOURLY_IDENTIFIER_LIMIT=5
AUTH_MFA_CHALLENGE_HOURLY_IDENTIFIER_LIMIT=5
AUTH_DISPATCH_MIN_RESPONSE_MS=250
AUTH_PENDING_USER_TTL_HOURS=48
AUTH_CLEANUP_INTERVAL_MINUTES=60
AUTH_EXPOSE_TEST_TOKENS=false
IDENTITY_EMAIL_OUTBOX_INTERVAL_MS=1000
IDENTITY_EMAIL_OUTBOX_CONCURRENCY=2
IDENTITY_EMAIL_OUTBOX_BATCH_SIZE=10
IDENTITY_EMAIL_OUTBOX_LEASE_SECONDS=120
IDENTITY_EMAIL_OUTBOX_MAX_ATTEMPTS=6
DOCUMENT_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters
DOCUMENT_ENCRYPTION_KEY_ID=primary-2026-08
DOCUMENT_ENCRYPTION_PREVIOUS_KEYS={}
BACKUP_ENCRYPTION_SECRET=replace-with-a-different-secret-of-at-least-32-characters
BACKUP_ENCRYPTION_KEY_ID=backups-2026-08
BACKUP_ENCRYPTION_PREVIOUS_KEYS={}

# The free public beta requires OCR but deliberately disables paid fulfillment.
MISTRAL_API_KEY=replace-with-a-real-mistral-key
MISTRAL_RULE_ANALYSIS_MODEL=mistral-small-latest
MANAGED_POSTAL_ENABLED=false
NEXT_PUBLIC_MANAGED_POSTAL_ENABLED=false
NEXT_PUBLIC_DOCUMENTS_PAGE_ENABLED=false
# Garder mock en profil free-beta ; utiliser manual avec le profil full.
POSTAL_PROVIDER=mock
SERVICE_POSTAL_ENV=sandbox
SERVICE_POSTAL_DEFAULT_PRODUCT=vertesuivi
SERVICE_POSTAL_PRODUCTION_ENABLED=false
SERVICE_POSTAL_API_KEY=
SERVICE_POSTAL_WEBHOOK_SECRET=
SERVICE_POSTAL_WEBHOOK_TOLERANCE_SECONDS=300
SERVICE_POSTAL_ALLOW_LEGACY_WEBHOOK_TOKEN=false
SERVICE_POSTAL_REQUEST_TIMEOUT_MS=10000
SERVICE_POSTAL_REQUEST_MAX_ATTEMPTS=2
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# Resend is mandatory for public support. NOTIFICATIONS_REQUIRED controls the
# other notification flows; it never disables the contact form.
NOTIFICATIONS_REQUIRED=false
RESEND_API_KEY=replace-with-a-real-resend-key
RESEND_FROM_EMAIL=Lydoc <notifications@example.com>
CONTACT_TO_EMAIL=support@example.com
CONTACT_DAILY_LIMIT=200
CONTACT_DAILY_EMAIL_LIMIT=3
CONTACT_DAILY_CLIENT_LIMIT=20
CONTACT_HOURLY_ATTEMPT_LIMIT=400
CONTACT_HOURLY_EMAIL_ATTEMPT_LIMIT=10
CONTACT_HOURLY_CLIENT_ATTEMPT_LIMIT=40

AI_DAILY_ACCOUNT_CALL_LIMIT=10
MISTRAL_DAILY_CALL_LIMIT=1000
MISTRAL_MAX_CONCURRENT_REQUESTS=2
MISTRAL_MIN_REQUEST_INTERVAL_MS=1100
DOCUMENT_PENDING_UPLOAD_GLOBAL_BYTES=524288000
DOCUMENT_UPLOAD_CONCURRENCY_GLOBAL=4
DOCUMENT_UPLOAD_CONCURRENCY_ACCOUNT=2
STORAGE_WRITE_RESERVATION_TTL_SECONDS=900
DOCUMENT_STORAGE_MIN_FREE_BYTES=1073741824
DOCUMENT_STORAGE_GLOBAL_BYTES=107374182400

DOCUMENT_RETENTION_DAYS=365
SENSITIVE_DOCUMENT_RETENTION_DAYS=30
DOCUMENT_DELETION_GRACE_DAYS=7
DOCUMENT_MIGRATION_BACKUP_DAYS=7
DOCUMENT_RETENTION_AUTOMATION_ENABLED=true
DOCUMENT_RETENTION_INTERVAL_MINUTES=360
ACCOUNT_ERASURE_PURGE_GRACE_DAYS=7
# Validate this legal-ledger duration with competent counsel before opening.
ACCOUNT_LEGAL_RECORD_RETENTION_DAYS=3650
LOG_HTTP=true
